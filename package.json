{
  "name": "@vpnsin-labs/devkit",
  "version": "0.2.4",
  "description": "Shared dev tooling for Node.js/Next.js, Python and .NET repos on GitHub or Azure Repos: lint/format/commit hooks, CI (GitHub Actions or Azure Pipelines), release automation and repo governance.",
  "type": "module",
  "prettier": "./prettier/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vpnsin-labs/devkit.git"
  },
  "homepage": "https://github.com/vpnsin-labs/devkit#readme",
  "bugs": {
    "url": "https://github.com/vpnsin-labs/devkit/issues"
  },
  "bin": {
    "devkit": "bin/cli.js"
  },
  "exports": {
    "./eslint": "./eslint/base.js",
    "./eslint/base": "./eslint/base.js",
    "./eslint/next": "./eslint/next.js",
    "./prettier": "./prettier/index.js",
    "./commitlint": "./commitlint/index.js",
    "./lint-staged": "./lint-staged/index.js",
    "./jest": "./jest/index.js",
    "./vitest": "./vitest/index.js",
    "./tsconfig/*": "./tsconfig/*",
    "./package.json": "./package.json"
  },
  "files": [
    "eslint",
    "prettier",
    "commitlint",
    "lint-staged",
    "jest",
    "vitest",
    "tsconfig",
    "templates",
    "bin",
    "lib",
    "README.md"
  ],
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "test": "node --test \"test/*.test.js\"",
    "test:govern": "node --check bin/cli.js && node -e \"Promise.all([import('./lib/govern/index.js'),import('./lib/govern/defaults.js')]).then(([i])=>{if(typeof i.runGovern!=='function')throw new Error('runGovern export missing');console.log('govern modules ok')})\"",
    "test:smoke": "node --check bin/cli.js && node -e \"import('./eslint/base.js').then(()=>console.log('eslint/base ok'))\""
  },
  "keywords": [
    "eslint-config",
    "prettier-config",
    "commitlint-config",
    "markdownlint",
    "husky",
    "lint-staged",
    "release-please",
    "config",
    "nextjs",
    "python",
    "ruff",
    "pre-commit",
    "dotnet",
    "csharp",
    "azure-devops",
    "azure-pipelines",
    "azure-repos",
    "renovate",
    "github-actions",
    "scaffold"
  ],
  "license": "MIT",
  "dependencies": {
    "@commitlint/config-conventional": "^21.0.2",
    "@eslint/js": "^10.0.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "globals": "^17.6.0",
    "typescript-eslint": "^8.21.0"
  },
  "peerDependencies": {
    "eslint": ">=9",
    "prettier": ">=3"
  },
  "peerDependenciesMeta": {
    "eslint-config-next": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "yaml": "^2.9.0"
  }
}
