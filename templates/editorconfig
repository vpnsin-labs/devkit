root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{bat,cmd}]
end_of_line = crlf

# Python and C# conventions use 4 spaces (PEP 8 / .NET defaults).
[*.py]
indent_size = 4

[*.{cs,csx,vb}]
indent_size = 4

[Makefile]
indent_style = tab
