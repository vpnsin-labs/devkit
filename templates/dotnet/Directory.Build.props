<Project>
  <!--
    Repo-wide build settings: every project under this directory inherits them
    (a project's own .csproj can still override any property). Managed by devkit;
    re-sync with `npx devkit init --dotnet --force`.
  -->
  <PropertyGroup>
    <!-- Single source of truth for the version — bumped by release-please / versionize. -->
    <Version>0.1.0</Version>

    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Quality gates: warnings fail the build; .editorconfig style rules are enforced at build time. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <!-- IDE0005 (unused usings) only runs in build when XML docs are generated; CS1591 (missing doc comment) is off. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <!-- Reproducible, CI-aware builds. -->
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(TF_BUILD)' == 'true' or '$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <AccelerateBuildsInVisualStudio>true</AccelerateBuildsInVisualStudio>

    <!-- Keep devkit's git-ignored scratch folder out of every project's default globs. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);temp/**</DefaultItemExcludes>
  </PropertyGroup>
</Project>
