<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Azure Artifacts feed "{{FEED}}" as the single package source (add nuget.org as an
    upstream source on the feed so public packages flow through it and get cached).
    Local auth: install the Azure Artifacts Credential Provider, then `dotnet restore
    --interactive`. CI auth: the NuGetAuthenticate@1 task (already in the pipelines).
  -->
  <packageSources>
    <clear />
    <add key="{{FEED}}" value="{{NUGET_URL}}" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="{{FEED}}">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
