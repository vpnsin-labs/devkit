#!/usr/bin/env sh
# devkit — prepare-commit-msg: link the commit to the Azure Boards work item named in
# the branch, so the "Work item linking" branch policy is satisfied without clicking
# through the PR UI. The first number with two or more digits in the branch name wins:
#   feature/1234-add-health-endpoint  →  appends "AB#1234"
#   bugfix/AB1234-null-ref, 1234-hotfix, users/me/ab#1234-x  →  AB#1234
# Skipped for merges, squashes, amends (-c/-C) and messages that already contain AB#<id>.
#
# Wired by devkit: Husky (.husky/prepare-commit-msg), pre-commit (prepare-commit-msg
# stage) or core.hooksPath=.githooks. Delete this file to opt out.
set -eu

msg_file="$1"
source="${2:-}"

case "$source" in
  merge|squash|commit) exit 0 ;;
esac

branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || true)
if [ -z "$branch" ] || [ "$branch" = "HEAD" ]; then
  exit 0
fi

id=$(printf '%s\n' "$branch" | grep -oE '[0-9]{2,}' | head -n 1 || true)
if [ -z "$id" ]; then
  exit 0
fi

if grep -qiE 'AB#[0-9]+' "$msg_file"; then
  exit 0
fi

printf '\n\nAB#%s\n' "$id" >> "$msg_file"
